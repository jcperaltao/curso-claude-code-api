# Valores locales ficticios para desarrollo. Copia este archivo a .env y ajústalo.
# No pongas secretos reales aquí.
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow_local_pw
POSTGRES_DB=taskflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Cadena de conexión async completa. Si se define, tiene prioridad sobre las
# variables POSTGRES_* de arriba. Formato: postgresql+asyncpg://user:pass@host:port/db
DATABASE_URL=postgresql+asyncpg://taskflow:taskflow_local_pw@localhost:5432/taskflow
