{
  "permissions": {
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff check *)",
      "Bash(uv run alembic *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git ls-files *)",
      "Bash(git ls-tree *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(.env)",
      "Bash(cat .env)",
      "Bash(docker compose down -v)",
      "Bash(docker compose down -v *)",
      "Bash(docker compose down --volumes)",
      "Bash(docker compose down --volumes *)"
    ]
  }
}
